DATABASE_URL=postgresql://user:password@localhost:5432/coffeedemo
PORT=3000

CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxx 

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=

PAYMONGO_SECRET_KEY=sk_test_xxxxxxxxxxxx
PAYMONGO_WEBHOOK_SECRET=whsk_xxxxxxxxxxxx   # from step 6
PAYMONGO_SUCCESS_URL=http://localhost:5173/checkout/success
PAYMONGO_CANCEL_URL=http://localhost:5173/checkout/cancel

# The admin console opens only for an active admin. While there is none,
# this address is made one at startup (an existing employee is promoted, or
# an invite is added that their first sign-in with the verified address claims).
ADMIN_EMAIL=

# The frontend origin, e.g. https://bullscoffee.vercel.app. Clerk invitations
# sent from the admin Users page send people to $APP_URL/sign-up.
APP_URL=http://localhost:5173

# Email (optional). Without these, orders still go through and the admin
# Notifications page says email is not set up. Uses Resend (resend.com):
# NOTIFY_FROM must be on a domain verified there, e.g. orders@yourdomain.com.
RESEND_API_KEY=
NOTIFY_FROM=
