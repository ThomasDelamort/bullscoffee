%% Bull's Coffee ER diagram, part 6 of 6: system
%% A breakdown of ERD.mmd. Source of truth: backend/init.sql.
%% Update the SCHEMA/ files whenever ERD.mmd changes.

%% Shows every relationship that touches a system table. System tables have all
%% their columns. Tables from other modules show only their key columns; the file
%% named on their PK has the full table. Notation and colors are as in ERD.mmd.
%% ON DELETE is NO ACTION (a referenced row can't be deleted) unless the column
%% says CASCADE or SET NULL.

%% 6 relationships, touching 4 of the 13 system tables. Every link to a table in
%% another module is SET NULL, so the system row outlives the person or order it
%% names. The only CASCADE is a ticket's messages.
%% The other 9 system tables have no foreign keys, so no line is drawn to them:
%% payment_settings, activity_logs, app_migrations, notification_templates,
%% notification_log, health_checks, request_metrics, backups, export_jobs.
%% Some of them still name rows elsewhere by value:
%% - activity_logs.actor_clerk_id     -> employees.clerk_id or customers.clerk_id
%% - notification_log.template_id     -> notification_templates.template_id
%% - notification_log.order_id        -> orders.order_id
%% - activity_logs.flag_reviewed_by, backups.created_by_name and
%%   export_jobs.requested_by_name store a person's name, not an id.

    classDef staffBox fill:#e6d9f7,stroke:#6a1b9a,color:#1a1a1a
    classDef salesBox fill:#dbe9fa,stroke:#1565c0,color:#1a1a1a
    classDef systemBox fill:#f8d7da,stroke:#c62828,color:#1a1a1a

%% =========================== SYSTEM ============================

%% Tables a backup restore must leave alone (activity_logs, backups, export_jobs,
%% notification_log, health_checks, request_metrics) hold no foreign keys to the
%% tables a restore replaces, so they keep names and plain ids instead.

%% Single row (settings_id = 1), inserted by init.sql. Which PayMongo methods
%% checkout offers. The API keys live in backend/.env, never here.
    payment_settings {
        int settings_id PK "DEFAULT 1, CHECK (settings_id = 1)"
        text[] enabled_methods "NOT NULL, DEFAULT ARRAY['gcash', 'paymaya', 'grab_pay', 'qrph', 'card']"
        boolean send_email_receipt "NOT NULL, DEFAULT TRUE"
    }

%% Single row (settings_id = 1), inserted by init.sql. maintenance_mode and
%% online_ordering stop kiosk orders; store_name and support_email go on every email.
%% maintenance_message DEFAULT 'We''re brewing some updates. Ordering will be back shortly!'
    system_settings {
        int settings_id PK "DEFAULT 1, CHECK (settings_id = 1)"
        varchar(100) store_name "NOT NULL, DEFAULT 'Bull''s Coffee'"
        varchar(255) support_email "NOT NULL, DEFAULT 'sup@bullscoffee.com'"
        boolean online_ordering "NOT NULL, DEFAULT TRUE"
        boolean maintenance_mode "NOT NULL, DEFAULT FALSE"
        text maintenance_message "NOT NULL, DEFAULT set in init.sql"
        boolean backup_enabled "NOT NULL, DEFAULT TRUE"
        varchar(10) backup_frequency "NOT NULL, DEFAULT 'daily', CHECK (backup_frequency IN ('hourly', 'daily', 'weekly'))"
        time backup_time "NOT NULL, DEFAULT '03:00'"
        int backup_retention_days "NOT NULL, DEFAULT 30, CHECK (backup_retention_days IN (7, 30, 90, 365))"
        timestamptz updated_at "NOT NULL, DEFAULT now()"
        int updated_by FK "NULLABLE, ON DELETE SET NULL"
    }

%% PDFs and CSV logs stored in S3 (bulls-coffee/pdfs/, bulls-coffee/logs/). This
%% table is the index of what's stored. file_url is NULL for logs, which are
%% private and only downloadable through the API.
    documents {
        serial document_id PK
        document_kind kind "NOT NULL (pdf / log)"
        varchar(255) file_name "NOT NULL"
        varchar(512) s3_key UK "NOT NULL"
        varchar(512) file_url "NULLABLE"
        int size_bytes "NOT NULL, CHECK (size_bytes >= 0)"
        int uploaded_by FK "NULLABLE, ON DELETE SET NULL"
        timestamptz uploaded_at "NOT NULL, DEFAULT now()"
    }

%% Activity log and audit trail. Insert-only apart from reviewing a flag; a row
%% with a flag_reason is in the audit trail until it's reviewed. session_id is set
%% only on sign-in rows, one per Clerk session.
%% INDEX activity_logs_occurred_at_idx (occurred_at DESC)
%% INDEX activity_logs_unreviewed_idx (log_id DESC) WHERE flag_reason IS NOT NULL AND flag_reviewed_at IS NULL
    activity_logs {
        bigserial log_id PK
        timestamptz occurred_at "NOT NULL, DEFAULT now()"
        varchar(255) actor_clerk_id "NULLABLE, no FK (staff, customer, or NULL for the system)"
        varchar(120) actor_name "NOT NULL"
        varchar(20) actor_role "NOT NULL, CHECK (actor_role IN ('admin', 'manager', 'cashier', 'customer', 'system'))"
        text action "NOT NULL"
        varchar(30) module "NOT NULL"
        varchar(45) ip "NULLABLE"
        log_severity severity "NOT NULL, DEFAULT 'info' (info / warning / critical)"
        text flag_reason "NULLABLE"
        varchar(120) flag_reviewed_by "NULLABLE"
        timestamptz flag_reviewed_at "NULLABLE"
        varchar(64) session_id UK "NULLABLE"
    }

%% One row per one-off data step that has run (e.g. a seed), so it never runs again.
    app_migrations {
        varchar(100) name PK
        timestamptz applied_at "NOT NULL, DEFAULT now()"
    }

%% Customer emails sent when something happens to an order. init.sql seeds four:
%% order-placed, order-completed, order-cancelled, payment-received.
    notification_templates {
        varchar(50) template_id PK
        varchar(50) event UK "NOT NULL"
        varchar(100) name "NOT NULL"
        varchar(200) subject "NOT NULL"
        text body "NOT NULL"
        boolean enabled "NOT NULL, DEFAULT TRUE"
        timestamptz updated_at "NOT NULL, DEFAULT now()"
    }

%% Every attempt to send one of those emails.
%% INDEX notification_log_sent_at_idx (sent_at DESC)
    notification_log {
        bigserial log_id PK
        varchar(50) template_id "NULLABLE, no FK (notification_templates)"
        int order_id "NULLABLE, no FK (orders)"
        varchar(255) recipient "NULLABLE"
        notification_status status "NOT NULL (sent / failed / skipped)"
        text error "NULLABLE"
        int latency_ms "NULLABLE"
        timestamptz sent_at "NOT NULL, DEFAULT now()"
    }

%% Complaints and bug reports from the storefront Contact form. customer_id is set
%% when the reporter was signed in; order_id when they named an order that exists.
%% INDEX support_tickets_status_idx (status, created_at DESC)
    support_tickets {
        serial ticket_id PK
        ticket_kind kind "NOT NULL (complaint / bug)"
        varchar(150) subject "NOT NULL"
        text description "NOT NULL"
        varchar(100) reporter_name "NOT NULL"
        varchar(255) reporter_email "NOT NULL"
        int customer_id FK "NULLABLE, ON DELETE SET NULL"
        int order_id FK "NULLABLE, ON DELETE SET NULL"
        ticket_priority priority "NOT NULL, DEFAULT 'medium' (low / medium / high / urgent)"
        ticket_status status "NOT NULL, DEFAULT 'open' (open / in_progress / resolved / closed)"
        timestamptz created_at "NOT NULL, DEFAULT now()"
        timestamptz updated_at "NOT NULL, DEFAULT now()"
    }

%% Staff replies, each also emailed to the reporter.
%% INDEX ticket_messages_ticket_id_idx (ticket_id)
    ticket_messages {
        serial message_id PK
        int ticket_id FK "NOT NULL, ON DELETE CASCADE"
        int author_employee_id FK "NULLABLE, ON DELETE SET NULL"
        varchar(120) author_name "NOT NULL"
        text body "NOT NULL"
        notification_status email_status "NOT NULL (sent / failed / skipped)"
        timestamptz created_at "NOT NULL, DEFAULT now()"
    }

%% One row per service per probe (each scheduler tick). Pruned after 30 days.
%% INDEX health_checks_service_idx (service, checked_at DESC)
    health_checks {
        bigserial check_id PK
        varchar(20) service "NOT NULL"
        varchar(15) state "NOT NULL, CHECK (state IN ('operational', 'degraded', 'down', 'not_configured'))"
        int latency_ms "NULLABLE"
        text detail "NULLABLE"
        timestamptz checked_at "NOT NULL, DEFAULT now()"
    }

%% API traffic per minute, summed across server instances. Pruned after 30 days.
    request_metrics {
        timestamptz minute PK
        int requests "NOT NULL, DEFAULT 0"
        bigint total_ms "NOT NULL, DEFAULT 0"
        int errors_5xx "NOT NULL, DEFAULT 0"
    }

%% Index of database snapshots: gzipped JSON in private S3 under bulls-coffee/backups/.
%% INDEX backups_created_at_idx (created_at DESC)
    backups {
        serial backup_id PK
        backup_kind kind "NOT NULL (automatic / manual)"
        job_status status "NOT NULL, DEFAULT 'in_progress' (in_progress / completed / failed)"
        varchar(512) s3_key UK "NULLABLE"
        bigint size_bytes "NULLABLE"
        jsonb table_counts "NULLABLE"
        text error "NULLABLE"
        varchar(120) created_by_name "NULLABLE"
        timestamptz created_at "NOT NULL, DEFAULT now()"
        timestamptz finished_at "NULLABLE"
    }

%% Data exports in private S3 under bulls-coffee/exports/, deleted with their row after 7 days.
%% INDEX export_jobs_requested_at_idx (requested_at DESC)
    export_jobs {
        serial export_id PK
        varchar(30) dataset "NOT NULL"
        export_format format "NOT NULL (csv / json)"
        date range_from "NULLABLE"
        date range_to "NULLABLE"
        job_status status "NOT NULL, DEFAULT 'in_progress' (in_progress / completed / failed)"
        varchar(512) s3_key UK "NULLABLE"
        int row_count "NULLABLE"
        bigint size_bytes "NULLABLE"
        text error "NULLABLE"
        varchar(120) requested_by_name "NULLABLE"
        timestamptz requested_at "NOT NULL, DEFAULT now()"
        timestamptz finished_at "NULLABLE"
    }

%% ======================= OTHER MODULES =========================

    employees {
        serial employee_id PK "full table in 01-staff.mmd"
    }

    customers {
        serial customer_id PK "full table in 02-sales.mmd"
    }

    orders {
        serial order_id PK "full table in 02-sales.mmd"
    }

%% ======================== RELATIONSHIPS ========================

%% employees 0..1 : 0..N system_settings. updated_by nullable, ON DELETE SET NULL.
%% The last staff member to change the settings. system_settings holds a single
%% row, so in practice this is 0..1 : 0..1.
    employees |o..o{ system_settings : "last updated"

%% employees 0..1 : 0..N documents. uploaded_by nullable, ON DELETE SET NULL.
%% The document's record stays when its uploader is removed.
    employees |o..o{ documents : "uploads"

%% customers 0..1 : 0..N support_tickets. customer_id nullable, ON DELETE SET NULL.
%% Set when the reporter was signed in; reporter_name and reporter_email are
%% stored on the ticket either way.
    customers |o..o{ support_tickets : "files"

%% orders 0..1 : 0..N support_tickets. order_id nullable, ON DELETE SET NULL.
%% Set when the reporter named an order that exists.
    orders |o..o{ support_tickets : "concerns"

%% support_tickets 1 : 0..N ticket_messages. ticket_id NOT NULL, ON DELETE CASCADE.
%% A ticket's reply thread is deleted with it.
    support_tickets ||..o{ ticket_messages : "threads"

%% employees 0..1 : 0..N ticket_messages. author_employee_id nullable, ON DELETE SET NULL.
%% author_name is copied onto each message, so a reply keeps its author's name
%% after the employee row is gone.
    employees |o..o{ ticket_messages : "writes"

    payment_settings:::systemBox
    system_settings:::systemBox
    documents:::systemBox
    activity_logs:::systemBox
    app_migrations:::systemBox
    notification_templates:::systemBox
    notification_log:::systemBox
    support_tickets:::systemBox
    ticket_messages:::systemBox
    health_checks:::systemBox
    request_metrics:::systemBox
    backups:::systemBox
    export_jobs:::systemBox
    employees:::staffBox
    customers:::salesBox
    orders:::salesBox
